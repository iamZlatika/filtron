generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model News {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  text_ru   String
  text_uk   String
  title_ru  String
  title_uk  String
}

model User {
  id       String @id @default(cuid())
  password String
  login    String @unique
}

model LoginAttempt {
  id          String   @id @default(cuid())
  ip          String   @unique
  count       Int      @default(1)
  lastAttempt DateTime @default(now())
}
